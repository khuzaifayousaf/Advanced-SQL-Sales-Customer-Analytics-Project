/* Moving Total Sales & Moving Average
#Advance Data Analytics Commulative Analysis
*/
select
t.Month_vise,
t.Total_Sales,
sum(Total_Sales) over ( partition by Month_vise
		order by Month_vise rows between 
		current row and unbounded following ) 
		as Running_Total_Sales,
t.Avg_Price,
avg(avg_price) over ( partition by Month_vise
order by month_vise rows between current row 
and unbounded following ) as Moving_Avg
from (
select
datetrunc(month,f.order_date) as Month_vise,
sum(f.sales) as Total_Sales,
avg(f.price) as Avg_Price
from gold.sales_fact as f
where f.order_date is not null
group by datetrunc(month,f.order_date)
)t;
/*	YEAR OVER YEAR ANALYSIS
#Advance Data Analytics Performance Analysis
*/
--Analyze the yearly performance of products
--by comparing their sales to both the avg sales
--performance of the product and the previous year's sales
with Yearly_Sales_Performance as (
select
year(f.order_date) as Year_Vise_Sales,
p.product_name,
sum(f.sales) as Total_Sales
from gold.sales_fact as f
left join gold.product_dim as p
on f.product_key = p.product_key
where f.order_date is not null
group by 
year(f.order_date),
p.product_name
)
-----
select*,
avg(s.total_sales) over (partition by product_name ) as avg_sales,
s.total_sales - avg(s.total_sales) over 
		(partition by product_name ) as  Tracking_Sales,
case when s.total_sales - avg(s.total_sales) over 
		(partition by product_name )>0 then 'Above Avg'
		when s.total_sales - avg(s.total_sales) over 
		(partition by product_name )<0 then 'Below Avg'
		else 'Avg'
END as Categorization,
lag(total_sales,1) over
	(partition by product_name order by 
		          s.Year_Vise_Sales ) as Previous_Years,
Total_Sales - lag(total_sales,1) over
	(partition by product_name order by 
		          s.Year_Vise_Sales ) as diff_previous_Year,
case when Total_Sales - lag(total_sales,1) over
	(partition by product_name order by 
		          s.Year_Vise_Sales )>0 then 'Increasing'
		when Total_Sales - lag(total_sales,1) over
	(partition by product_name order by 
		          s.Year_Vise_Sales )<0 then 'Decreasing'
		else 'No Change'
END as flag_diff_previous_Year
from Yearly_Sales_Performance as s
;GO
/*	PART TO WHOLE ANALYSIS
#Advance Data Analytics Performance Analysis
*/
--Which Category Contribute the Most Overall Sales
select*,
sum(total_sales) over() as Overall_Sales,
concat(round((cast(Total_Sales as float))/(sum(total_sales)
		over())*100 ,2),'%') as Overall_Performance
from 
(select
p.product_category,
sum(f.sales) as Total_Sales
from gold.sales_fact as f
left join gold.product_dim as p
on f.product_key = p.product_key
group by p.product_category)t
order by Overall_Performance desc;
