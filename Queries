/*	Data Segement Analysis
#Advance Data Analytics Data Segementation Analysis
*/
--Segment Products into cost range and count
--how many products fall into each segment
with segement_products as (
select
p.product_key,
p.product_name,
p.product_cost,
case when product_cost<100 then 'Below - 100'
	when product_cost between 100 and 500 then 'B/w 100 & 500'
	when product_cost between 500 and 1000 then 'B/w 500 & 1000'
	else 'Above 1000'
end as cost_range
from gold.product_dim as p
)
select
sp.cost_range,
count(sp.product_key) as Total_Products
from segement_products as sp
group by sp.cost_range
order by Total_Products desc;
go
/*	Data Segement Analysis
#Advance Data Analytics Data Segementation Analysis
Group Customers Based on their Spending Behaviour
 - VIP : Customers with atleast 12 months of History
		and spending more than $ 5000
- Regular : Customers with atleast 12 months of History
		and spending = $ 5000 or less
- New : Customers with lifespam less than 12 months
and also find total number of customers by each Group
*/
with customer_spending_behaviour as (
select
c.customer_key,
min(f.order_date) as First_Order,
max(f.order_date) as Last_Order,
sum(f.sales) as Total_Sales,
datediff(month,min(f.order_date),max(f.order_date)) as Life_Spam
from gold.sales_fact as f
left join gold.customer_dim as c
on f.customer_key = c.customer_key
group by c.customer_key),
customer_category as (
select
b.customer_key,
b.Total_Sales,
b.Life_Spam,
case when Total_Sales > 5000 and Life_Spam >=12 then 'VIP Customer'
	when Total_Sales <=5000 and Life_Spam >=12 then 'Regular Customer'
	when Life_Spam<12 then 'New Customer'
	else 'n/a'
end as Customer_Category
from customer_spending_behaviour as b
where Life_Spam is not null)
--------
select
Customer_Category,
count(customer_key) as Total_Customers
--and also find total number of customers by each Group
from customer_category as c
group by Customer_Category
order by Total_Customers asc;
go

/*
==================================================
Customer Repoort
==================================================
Purpose : 
		This Report Consolidates Key Customer matrics 
		& Behaviour
Highlights:
 1).  Gather essential fields such as names,ages & 
		teansactional details.
 2).  Segement customers into categories 
        (VIP,REGULAR & NEW )& age groups
 3). Aggregate customer level matrics:
    - Total Orders
	- Total Sales
	- Total Quantity Purchased
	- Total Products 
	- Lifspan (in Months )
 4). Calculate the valuable KPIs:
		recency ( Months since last Order )
		average order value
		average monthly spend
*/
create view gold.customer_report as 
With base_report_step as (
select
f.sales_order_number,
c.customer_key,
c.customer_name,
f.product_key,
CONCAT(c.firstname,c.lastname) as Name,
f.order_date,
datediff(year,c.birthdate,getdate()) as age,
f.price,
f.quantity,
f.sales
from gold.sales_fact as f
left Join gold.customer_dim as c
on f.customer_key = c.customer_key
where f.order_date is not null),
----
customer_aggregation as (
select
b.customer_key,
b.customer_name,
b.Name,
b.age,
count(distinct b.sales_order_number) as total_orders,
sum(b.sales) as total_sales,
sum(b.quantity) as total_quantity,
datediff(month,max(b.order_date),GETDATE()) as recency,
count( distinct b.product_key) as total_products,
DATEDIFF(month,min(b.order_date),max(b.order_date)) as lifespan
from base_report_step as b
group by 
	b.customer_key,
	b.customer_name,
	b.Name,
	b.age
)
select
cg.customer_key,
cg.customer_name,
cg.Name,
cg.age,
case when age <20 then 'Under 20'
	when age between 20 and 29 then '20-29'
	when age between 30 and 39 then '30-39'
	when age between 40 and 49 then '40-49'
	else '50 and above'
end as age_category,
case when total_sales> 5000 and lifespan>12 then 'VIP Customer'
	when total_sales<= 5000 and lifespan>12 then 'Regular Customer'
	when lifespan<12 then 'New Customer'
	else 'n/a'
end as customer_category,
cg.recency,
cg.total_orders,
cg.total_sales,
case when cg.total_sales  = 0 then 0
	else cg.total_sales/cg.total_orders
end  as average_order_value,
case when lifespan = 0 then total_sales
	else total_sales/lifespan 
end as avg_monthly_spend,
cg.total_quantity,
cg.total_products,
cg.lifespan
from customer_aggregation AS cg;
