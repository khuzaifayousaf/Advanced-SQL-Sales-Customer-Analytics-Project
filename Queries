/* Change Over Time Analysis 
#Advance Data Analytics
*/
select
year(f.order_date) as Order_Date_By_Year,
sum(f.sales) as Total_Sales,
count(f.customer_key) as Total_Customers,
sum(f.quantity) as Total_Quantity
from gold.sales_fact as f
where f.order_date is not null
group by year(f.order_date)
order by Order_Date_By_Year;
go
/* Change Over Time Analysis 
#Advance Data Analytics
*/
select
year(f.order_date) as Order_Date_By_Years,
month(f.order_date) as Order_Date_By_Months,
format(sum(f.sales),'c') as Total_Sales,
count(f.customer_key) as Total_Customers,
sum(f.quantity) as Total_Quantity
from gold.sales_fact as f
where f.order_date is not null
group by month(f.order_date),
year(f.order_date)
order by Total_Sales desc;
go

